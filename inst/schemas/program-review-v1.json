{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sas2r.dev/schemas/program-review-v1.json",
  "title": "sas2r program review output",
  "x-sas2r-schema-version": "1",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "reviewed_no_material_finding",
        "repair_required",
        "review_unavailable"
      ]
    },
    "static_runnability": {
      "type": "string",
      "enum": [
        "looks_runnable",
        "known_blocker",
        "material_issue",
        "unknown"
      ]
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "material",
              "high",
              "medium",
              "low"
            ]
          },
          "sas_evidence": {
            "type": "string",
            "minLength": 1
          },
          "r_evidence": {
            "type": "string",
            "minLength": 1
          },
          "affected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unresolved_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "severity",
          "sas_evidence",
          "r_evidence",
          "affected_outputs",
          "confidence",
          "unresolved_dependencies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "static_runnability",
    "unresolved_dependencies",
    "findings"
  ],
  "additionalProperties": false
}
