{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sas2r.dev/schemas/program-translation-v1.json",
  "title": "sas2r program translation output",
  "x-sas2r-schema-version": "1",
  "type": "object",
  "properties": {
    "r_code": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "default": {}
        },
        "required": [
          "name",
          "type",
          "required",
          "default"
        ],
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "helper_use": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "discovered_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "suspected_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "affected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "material",
              "high",
              "medium",
              "low"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "affected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "severity",
          "claim",
          "evidence",
          "affected_outputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "r_code",
    "summary",
    "parameters",
    "defaults",
    "reads",
    "writes",
    "side_effects",
    "helper_use",
    "discovered_dependencies",
    "suspected_dependencies",
    "affected_outputs",
    "uncertainty"
  ],
  "additionalProperties": false
}
